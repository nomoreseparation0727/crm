# Copy to .env for local scraper runs, or set these as Railway service
# variables (both the scraper and dashboard services need DATABASE_URL;
# only the scraper needs the SEC_EDGAR_* / BURGUNDY_* ones).

# Postgres connection string. On Railway, reference the Postgres plugin's
# DATABASE_URL variable (e.g. via a shared variable or ${{Postgres.DATABASE_URL}}).
DATABASE_URL=postgresql://user:password@localhost:5432/burgundy

# REQUIRED by SEC EDGAR for any automated request -- must be a real contact,
# or requests get 403/429'd. Format: "<app or company name> <email>".
# See https://www.sec.gov/os/webmaster-faq#developers
SEC_EDGAR_USER_AGENT=YourAppName you@example.com

# Optional: skips best-effort name resolution against EDGAR (recommended --
# look this up once at https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&company=burgundy+asset&type=13F
# and hardcode it here so the scraper never guesses the wrong filer entity).
# BURGUNDY_SEC_CIK=0001234567

# Optional overrides -- defaults assume burgundyasset.com's structure, which
# was not directly inspectable while building this (see scraper/README.md).
# BURGUNDY_COMPANY_NAME=Burgundy Asset Management
# BURGUNDY_WEBSITE_URL=https://www.burgundyasset.com
# BURGUNDY_TEAM_URL=https://www.burgundyasset.com/people/
# BURGUNDY_FUNDS_URL=https://www.burgundyasset.com/funds/
